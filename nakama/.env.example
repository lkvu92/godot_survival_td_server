# ==============================================================================
# Environment Configuration for Nakama Production Stack
# ==============================================================================
# Copy this file to `.env` inside `nakama/` (or project root):
#   cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_DB=nakama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=NakamaSecureDb2026!
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Nakama Server Configuration
NAKAMA_HTTP_PORT=7350
NAKAMA_GRPC_PORT=7349
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=7351

# Environment: "develop" or "production"
APP_ENVIRONMENT=production
NAKAMA_HTTP_KEY=monetization-http-key-secure-2026

# Monetization Verifier Service
MONETIZATION_PORT=8082
MONETIZATION_VERIFIER_SECRET=monetization-verifier-secret-secure-2026
ADMOB_REWARDED_UNIT_ID_DEVELOP=ca-app-pub-3940256099942544/5224354917
ADMOB_REWARDED_UNIT_ID_PRODUCTION=ca-app-pub-2623237649967496/5496497462
NAKAMA_PRODUCTION_URL=http://nakama:7350
GOOGLE_PUBSUB_AUDIENCE=https://api.yourdomain.com/google-play/rtdn

# Runtime bindings: fill secret values before configuring/starting Nakama.
# MFA storage encryption key must meet Nakama length requirements.
NAKAMA_SERVER_KEY=
NAKAMA_CONSOLE_USERNAME=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=
NAKAMA_CONSOLE_MFA_KEY=
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=
NAKAMA_HTTP_BIND=127.0.0.1
NAKAMA_GRPC_BIND=127.0.0.1
MONETIZATION_BIND=127.0.0.1
ANDROID_PACKAGE_NAME=vn.lkvu92.survivaltd
# Verifier uses this package and a read-only nakama/google-play-service-account.json.
# Supply the Google service-account JSON before starting the production verifier.
CONFIG_ADMIN_USER_ID=
# Comma-separated email allowlist for Google Play License Tester test purchases in production.
GOOGLE_PLAY_TESTER_EMAILS=

# C232: enable only after SMTP, HTTPS proxy and client release are ready.
ACCOUNT_IDENTITY_ENABLED=false
ACCOUNT_IDENTITY_PORT=18083
ACCOUNT_IDENTITY_PUBLIC_URL=https://api.lkvustudio.com
# Independent random 32-byte secrets, encoded as 64 hex. Do not reuse existing credentials.
ACCOUNT_IDENTITY_SECRET=
ACCOUNT_IDENTITY_OUTBOX_KEY=
# Comma-separated Google WEB client IDs, never Android client IDs.
GOOGLE_WEB_CLIENT_IDS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Google App Password, not normal Gmail password. 2-Step Verification required.
SMTP_USER=
SMTP_PASSWORD=
# Use SMTP_USER or an authorized Gmail alias.
SMTP_FROM=
SMTP_REPLY_TO=admin@lkvustudio.com
