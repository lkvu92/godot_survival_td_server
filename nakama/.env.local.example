# Local development only. Copy to .env.local; never use these values on a public server.
POSTGRES_DB=nakama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_ON_FIRST_RUN
POSTGRES_PORT=15432
NAKAMA_HTTP_PORT=7350
NAKAMA_GRPC_PORT=17349
CONSOLE_PORT=17351
MONETIZATION_PORT=18082
APP_ENVIRONMENT=develop
ANDROID_PACKAGE_NAME=vn.lkvu92.survivaltd
CONFIG_ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
NAKAMA_SERVER_KEY=GENERATE_ON_FIRST_RUN
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=GENERATE_ON_FIRST_RUN
NAKAMA_CONSOLE_SIGNING_KEY=GENERATE_ON_FIRST_RUN
NAKAMA_CONSOLE_MFA_KEY=GENERATE_ON_FIRST_RUN
NAKAMA_SESSION_ENCRYPTION_KEY=GENERATE_ON_FIRST_RUN
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=GENERATE_ON_FIRST_RUN
NAKAMA_HTTP_KEY=GENERATE_ON_FIRST_RUN
MONETIZATION_VERIFIER_SECRET=GENERATE_ON_FIRST_RUN
ADMOB_REWARDED_UNIT_ID_DEVELOP=ca-app-pub-3940256099942544/5224354917
ADMOB_REWARDED_UNIT_ID_PRODUCTION=ca-app-pub-2623237649967496/5496497462
GOOGLE_PLAY_TESTER_EMAILS=

# C232: enable only after SMTP, HTTPS proxy and client release are ready.
ACCOUNT_IDENTITY_ENABLED=false
ACCOUNT_IDENTITY_PORT=18083
ACCOUNT_IDENTITY_PUBLIC_URL=https://api.lkvustudio.com
# Independent random 32-byte secrets, encoded as 64 hex. Do not reuse existing credentials.
ACCOUNT_IDENTITY_SECRET=
ACCOUNT_IDENTITY_OUTBOX_KEY=
# Comma-separated Google WEB client IDs, never Android client IDs.
GOOGLE_WEB_CLIENT_IDS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Google App Password, not normal Gmail password. 2-Step Verification required.
SMTP_USER=
SMTP_PASSWORD=
# Use SMTP_USER or an authorized Gmail alias.
SMTP_FROM=
SMTP_REPLY_TO=admin@lkvustudio.com
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SMS_TYPE=4
SPEEDSMS_SENDER=
SPEEDSMS_OTP_HMAC_KEY=
SPEEDSMS_CONTENT=Ma xac thuc cua dao huu la {pin_code}. Khong chia se ma nay.

# C232 v2: independent AES-256 key for mandatory retained records. Missing = no hard purge.
ACCOUNT_RETENTION_KEY=

# Non-secret key identifier; must match the versioned archive policy.
ACCOUNT_RETENTION_KEY_ID=

# Private optional keyring JSON; keep old keys while pending snapshots/backups need them.
ACCOUNT_RETENTION_KEYS_JSON=

# Operator-host recovery keys; provision independently in a protected secret store.
# Never put these in client/runtime config. PostgreSQL16 client tools are required.
ACCOUNT_RECOVERY_BACKUP_KEY=
ACCOUNT_RECOVERY_SIGNING_KEY=
ACCOUNT_RECOVERY_ARTIFACT_DIR=
